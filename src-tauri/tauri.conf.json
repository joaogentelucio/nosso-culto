{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nosso Culto",
  "version": "0.1.0",
  "identifier": "br.com.nossoculto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nosso Culto",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ]
  }
}